# ---- LLM ----
# Default backend: Groq — free, fast, and generous quota (nothing heavy runs on
# your machine). Use this if a local model (e.g. Ollama) made your laptop lag or
# freeze, or if Hugging Face's free Inference API credits ran out.
LLM_BACKEND=groq
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# llama-3.1-8b-instant is fast; llama-3.3-70b-versatile trades speed for quality.
GROQ_MODEL=llama-3.1-8b-instant

# ---- LLM: Hugging Face (alternative backend, LLM_BACKEND=hf_api) ----
# Get a free token (read access is enough): https://huggingface.co/settings/tokens
HF_TOKEN=
# Which models work depends on the Inference Providers enabled for your HF account
# and its remaining free credits — if you get a "not supported by any provider" or
# "402 Payment Required" error, switch back to Groq or try a different HF_MODEL.
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Only used when LLM_BACKEND=hf_local (needs a real GPU + bitsandbytes)
HF_LOCAL_4BIT=true

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120

# ---- Embeddings / Reranker (BAAI BGE) ----
EMBED_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBED_DEVICE=cpu          # set to cuda if you have a GPU

# ---- Retrieval ----
DENSE_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=5
MULTI_QUERY_N=3
SELF_RAG_MAX_RETRIES=2

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000

# ---- ngrok (optional public demo) ----
NGROK_AUTHTOKEN=
